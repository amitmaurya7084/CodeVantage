# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017/


# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_a_different_long_random_string

# Certificate fee (₹) — shown to students on the UPI payment page
CERTIFICATE_FEE_INR=149

# Email (optional) — sent via Brevo's HTTPS API, so it works on Render's free plan.
# Leave empty to run without email (emails are skipped; forgot-password won't deliver links).
# Free key: brevo.com -> SMTP & API -> API Keys. Verify MAIL_FROM_EMAIL under Senders & IP.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CodeVantage

# Public site URL (used in QR code verification links)
PUBLIC_SITE_URL=http://localhost:5173

# One-time admin seed (used only by `npm run seed:admin`)
ADMIN_SEED_NAME=CodeVantage Admin
ADMIN_SEED_EMAIL=admin@codevantage.in
ADMIN_SEED_PASSWORD=change_this_before_running

# Cloudinary (image/video uploads for the CMS Media Library)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: max API requests per IP per 15 minutes (default 300 in production, 5000 in development)
# RATE_LIMIT_MAX=300

# Set to "none" only if frontend and backend are on different sites (e.g. two *.onrender.com URLs). Default: lax
# COOKIE_SAMESITE=lax
